{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["docs/PRD.md", "CLAUDE.md"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": ["coverage/**", "!coverage/.tmp/**"]
    }
  }
}
